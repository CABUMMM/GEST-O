{
  "entities": {
    "User": {
      "title": "User",
      "description": "User representing a manager or an interviewer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "nome": { "type": "string" },
        "cpf": { "type": "string" },
        "cargo": { "type": "string", "enum": ["gestor", "entrevistador"] },
        "territorio": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "bloqueado"] },
        "senha": { "type": "string" }
      },
      "required": ["id", "username", "nome", "cpf", "cargo", "territorio", "status"]
    },
    "Visit": {
      "title": "Visit",
      "description": "Home visit request and status details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "cpf": { "type": "string" },
        "endereco": { "type": "string" },
        "numero": { "type": "string" },
        "complemento": { "type": "string" },
        "bairro": { "type": "string" },
        "territorio": { "type": "string" },
        "telefone": { "type": "string" },
        "motivo": { "type": "string" },
        "nomeEntrevistador": { "type": "string" },
        "entrevistadorId": { "type": "string" },
        "dataSolicitacao": { "type": "string" },
        "dataLimite": { "type": "string" },
        "observacoes": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Concluída", "FINALIZADA - NÃO LOCALIZADO"] },
        "dataConclusao": { "type": "string" },
        "cpfConclusao": { "type": "string" },
        "observacoesConclusao": { "type": "string" },
        "tentativas": { "type": "array" }
      },
      "required": ["id", "nome", "cpf", "endereco", "numero", "bairro", "territorio", "telefone", "motivo", "nomeEntrevistador", "entrevistadorId", "dataSolicitacao", "status", "tentativas"]
    },
    "Territory": {
      "title": "Territory",
      "description": "A division block in Ipatinga tied to a CRAS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "cras": { "type": "string" },
        "bairros": { "type": "array" },
        "responsavel": { "type": "string" }
      },
      "required": ["id", "nome", "cras", "bairros"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "System users collection"
    },
    "visits/{visitId}": {
      "schema": "Visit",
      "description": "System visits records"
    },
    "territories/{territoryId}": {
      "schema": "Territory",
      "description": "Divided territories list"
    }
  }
}
