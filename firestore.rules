rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Collection: Users
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Collection: Visits
    match /visits/{visitId} {
      allow read: if true;
      allow create, update: if isValidId(visitId);
      allow delete: if isValidId(visitId);
    }

    // Collection: Territories
    match /territories/{territoryId} {
      allow read: if true;
      allow create, update: if isValidId(territoryId);
      allow delete: if isValidId(territoryId);
    }
  }
}
